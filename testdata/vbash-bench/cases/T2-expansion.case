# T2：展开。语料占比 2.6%（变量 4.4%、命令替换 2.7%），但一旦用上就必须正确，
# 且"引号内是否展开"是常见实现错误来源。

--- name: T2/001-var-assign-use
command:
  X=abc; echo "$X"

--- name: T2/002-var-unquoted-word-splitting
# 未加引号的变量要做分词（IFS），这是 vs 加引号的关键差异
command:
  X="a  b"; printf '[%s]' $X; echo

--- name: T2/003-var-quoted-no-split
command:
  X="a  b"; printf '[%s]' "$X"; echo

--- name: T2/004-var-in-single-quotes
# 单引号内不展开
command:
  X=abc; echo '$X'

--- name: T2/005-var-braces
command:
  X=abc; echo "${X}def"

--- name: T2/006-var-default
command:
  unset Z; echo "${Z:-dflt}"; echo "${Z-fallback}"

--- name: T2/007-var-length
command:
  X=abcdef; echo "${#X}"

--- name: T2/008-var-trim-suffix
command:
  F=a/b/c.txt; echo "${F##*/}"; echo "${F%.*}"; echo "${F%%.*}"

--- name: T2/009-var-replace
command:
  X=a-b-c; echo "${X/-/_}"; echo "${X//-/_}"

--- name: T2/010-cmdsub-basic
command:
  echo "$(echo hi)"

--- name: T2/011-cmdsub-nested-quotes
command:
  echo "x=$(printf 'a b')"

--- name: T2/012-cmdsub-in-assignment
command:
  N=$(printf 'a\nb\nc\n' | wc -l); echo "n=$N"

--- name: T2/013-cmdsub-strips-trailing-newlines
command:
  X=$(printf 'v\n\n\n'); printf '[%s]' "$X"; echo

--- name: T2/014-cmdsub-exit-code
# $? 反映命令替换是否成功
command:
  X=$(false); echo "rc=$?"

--- name: T2/015-cmdsub-in-arg
command:
  echo prefix-$(echo mid)-suffix

--- name: T2/016-arithmetic
command:
  echo $((1+2*3))

--- name: T2/017-arithmetic-var
command:
  N=4; echo $((N*N))

--- name: T2/018-tilde-expand
# 语料 23.5% 的命令用 ~/ 开头，虚拟实现要做 HOME 展开
command:
  echo ~ | grep -c .

--- name: T2/019-tilde-in-path
command:
  mkdir -p ~/d && echo x > ~/d/f && cat ~/d/f

--- name: T2/020-special-question
command:
  true; echo $?

--- name: T2/021-special-hash
command:
  set -- a b c; echo $#

--- name: T2/022-special-at
command:
  set -- a b; printf '[%s]' "$@"; echo

--- name: T2/023-special-star
command:
  set -- a b; printf '[%s]' "$*"; echo

--- name: T2/024-export-visible-to-child
command:
  export FOO=bar; sh -c 'echo "$FOO"'

--- name: T2/025-not-exported-invisible
# 未 export 的变量不应出现在子进程环境里
command:
  FOO2=bar2; sh -c 'echo "[${FOO2}]"'

--- name: T2/026-dollar-single-quote
# ANSI-C 引用 $'...'（语料 0.2%）
command:
  printf '%s' $'a\tb'; echo

--- name: T2/027-backslash-escape
command:
  echo "a\"b"

--- name: T2/028-cmdsub-with-pipe
command:
  echo "$(printf 'x\ny\n' | head -1)"

--- name: T2/029-var-adjacent-text
# $Xdef 会被解析成变量 Xdef，不是 X + def —— 常见解析错误
command:
  X=1; Xdef=2; echo "$Xdef"; echo "${X}def"

--- name: T2/030-glob-expand
# glob 展开（语料仅 1.1%，但 ls 类命令依赖它）
command:
  echo *.txt
files: {"a.txt": "x\n", "b.txt": "y\n"}

--- name: T2/031-glob-no-match-literal
# 无匹配时 bash 保留字面量（nullglob 未开）
command:
  echo *.nomatch

--- name: T2/032-env-var-from-proc
command:
  FOO=xyz sh -c 'echo $FOO'

--- name: T2/033-empty-quoted-arg-count
# 空引号参数必须保留为一个参数，不能被丢弃（参数个数、位置参数都会错位）
command:
  f() { echo $#; }; f ""; f ''; f "" ""

--- name: T2/034-empty-quoted-in-middle
# 中间的空参数不能吞掉，否则后续位置参数整体前移
command:
  f() { echo "$#:[$1][$2][$3]"; }; f a "" b

--- name: T2/035-empty-quoted-at-iteration
command:
  f() { for a in "$@"; do echo "<$a>"; done; }; f "" x

--- name: T2/036-empty-test-n
# [ -n "" ] 必须为假：空引号参数被丢弃时会退化成单参数形式而误判为真
command:
  if [ -n "" ]; then echo T; else echo F; fi

--- name: T2/037-empty-quoted-concat
# 空引号与字面量拼接仍是一个参数
command:
  echo x""y; echo ""

--- name: T2/038-brace-list
# 大括号列表展开：多个字段、前后缀保留
command:
  printf '<%s>' pre{a,b}post; echo

--- name: T2/039-brace-range-num
command:
  printf '<%s>' {1..3}; echo; printf '<%s>' {01..03}; echo

--- name: T2/040-brace-range-step
command:
  printf '<%s>' {1..10..3}; echo; printf '<%s>' {a..e..2}; echo

--- name: T2/041-brace-nested-cartesian
command:
  printf '<%s>' {a,b}{1,2}; echo

--- name: T2/042-brace-quoted-no-expand
# 引号内与转义的大括号不展开
command:
  printf '<%s>' "{a,b}"; echo; printf '<%s>' a\{1,2\}b; echo

--- name: T2/043-brace-in-for-list
command:
  for i in {1..3}; do echo "i=$i"; done

--- name: T2/044-brace-no-comma-literal
# 没有逗号也不是范围：按字面保留
command:
  printf '<%s>' {a}; echo; printf '<%s>' {}; echo

--- name: T2/045-printf-float-precision
command:
  printf '%.3f|%8.2f|%-8.2f|\n' 3.14159 2.5 2.5

--- name: T2/046-printf-scientific
command:
  printf '%e|%.3e|%E\n' 1234.5 1234.5 1234.5; printf '%g|%g|%g\n' 1000000 1234567 0.0001

--- name: T2/047-printf-int-precision
command:
  printf '%.3d|%.5d|%.0d|\n' 5 42 7; printf '%.5d\n' -42

--- name: T2/048-printf-flags
command:
  printf '%+d|% d|%#x|%#o|%08d|\n' 5 5 255 8 42

--- name: T2/049-printf-unsigned-hex
command:
  printf '%u|%x|%X\n' -1 -1 255

--- name: T2/050-read-file-substitution
# $(&lt;file) 等价 $(cat file)，不经过子进程
setup: mkdir -p d && printf 'hello\nworld\n' > d/in.txt
command:
  cd d; echo "[$(<in.txt)]"; x=$(<in.txt); echo "[$x]"

--- name: T2/051-read-file-substitution-missing
# 读不到文件：空输出 + 诊断，整体退出码不变
command:
  echo "[$(</nonexistent-vbash-xyz)]"


--- name: T2/052-brace-nest-within-limit
# 嵌套深度上限内（10 层）的展开结果与 bash 一致
command:
  printf '%s\n' {a,{a,{a,{a,{a,{a,{a,{a,{a,{a,x}}}}}}}}}} | wc -l

--- name: T2/053-brace-cartesian-within-limit
# 连写 13 组共 8192 个字段，仍在上限内
command:
  printf '%s\n' {a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b} | wc -l

--- name: T2/054-heredoc-adjacent-expansion-in-assignment
# 赋值右侧的 $( ) / $(( )) / ${x:-} 混写
command:
  v=4
  s="a$(echo b)c$((v+1))d${nope:-e}"
  echo "$s"

--- name: T2/055-empty-quotes-in-heredoc-body
command:
  cat <<EOF
  []
  EOF

--- name: T2/056-arith-dollar-brace-with-op
command:
  v=4
  echo $(( ${v:-1} + ${nope:-2} ))

--- name: T2/057-star-quoted-default-ifs
command:
  set -- a b c
  echo "[$*] [$@] [$#]"
