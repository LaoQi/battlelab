# T3-b：控制流。语料里合计不足 6%，但都是「脚本形态」，虚拟实现能否跑通常卡在这。
# for/do/done 3.8%、if/then 0.3%、while 0.17%、case 0.11%、函数 0.19%。

--- name: T3c/101-for-list
# 语料里最典型的形态：for f in a b c; do ...; done
command:
  for f in a b c; do echo "== $f"; done

--- name: T3c/102-for-glob
command:
  for f in *.txt; do echo "$f"; done
files: {"x.txt": "1\n", "y.txt": "2\n"}

--- name: T3c/103-for-multiline-body
command:
  for f in a b; do
    echo "start $f"
    echo "end $f"
  done

--- name: T3c/104-for-cmdsub-list
command:
  for n in $(printf 'p\nq\n'); do echo "-$n"; done

--- name: T3c/105-for-with-break
command:
  for i in 1 2 3; do [ "$i" = 2 ] && break; echo $i; done

--- name: T3c/106-for-with-continue
command:
  for i in 1 2 3; do [ "$i" = 2 ] && continue; echo $i; done

--- name: T3c/107-while-counter
command:
  i=0; while [ $i -lt 3 ]; do echo "i=$i"; i=$((i+1)); done

--- name: T3c/108-while-read-lines
# 逐行读文件——脚本里常见，依赖 read 与 stdin
command:
  while read -r line; do echo "L:$line"; done < f.txt
files: {"f.txt": "one\ntwo\n"}

--- name: T3c/109-if-then-else
command:
  if [ -f f.txt ]; then echo yes; else echo no; fi
files: {"f.txt": "x\n"}

--- name: T3c/110-if-elif
command:
  x=2; if [ "$x" = 1 ]; then echo one; elif [ "$x" = 2 ]; then echo two; else echo other; fi

--- name: T3c/111-if-test-operators
command:
  [ -d sub ] && echo dir; [ -e sub/a ] && echo exists
files: {"sub/a": "1\n"}

--- name: T3c/112-if-string-compare
command:
  [ "abc" = "abc" ] && echo eq; [ "abc" != "x" ] && echo ne

--- name: T3c/113-case-basic
command:
  v=b; case "$v" in a) echo A;; b) echo B;; *) echo other;; esac
optional: true

--- name: T3c/114-case-glob-pattern
command:
  f=img.png; case "$f" in *.png|*.jpg) echo image;; *) echo other;; esac
optional: true

--- name: T3c/115-function-define-call
command:
  greet() { echo "hi $1"; }; greet world

--- name: T3c/116-function-local-var
command:
  f() { local v=inner; echo "$v"; }; v=outer; f; echo "$v"

--- name: T3c/117-function-return-status
command:
  f() { return 3; }; f; echo "rc=$?"

--- name: T3c/118-subshell-vs-brace-group
command:
  ( echo sub ) ; { echo grp; }

--- name: T3c/119-brace-group-shared-vars
# { } 在当前 shell 执行，变量影响外层；( ) 反之
command:
  x=1; { x=2; }; echo $x; ( x=3 ); echo $x

--- name: T3c/120-nested-if-in-for
command:
  for f in a b; do if [ "$f" = a ]; then echo first; else echo rest; fi; done

--- name: T3c/121-if-with-pipeline-condition
command:
  if echo hello | grep -q ell; then echo match; fi

--- name: T3c/122-double-bracket
# [[ ]] 在语料中为 0 次，作为「可选支持」用例：不支持时应能报错而不是误执行
command:
  [[ -f f.txt ]] && echo exists
optional: true
files: {"f.txt": "1\n"}

--- name: T3c/123-arith-in-condition
command:
  i=2; if [ $((i*2)) -eq 4 ]; then echo four; fi

--- name: T3c/124-exit-in-script
command:
  echo before; exit 5; echo after
expect_exit: 5

--- name: T3c/125-set-minus-e
# set -e 严格模式：语料 0.22%，但脚本里出现就要正确处理
command:
  set -e; false; echo unreachable

--- name: T3c/126-function-recursion-within-limit
# 递归 200 层的正常用法：上限（512）内结果与 bash 一致
command:
  f() { if [ "$1" -lt 200 ]; then f $(( $1 + 1 )); else echo bottom; fi; }; f 0

--- name: T3c/127-function-in-pipeline
# 管道段与命令替换里都能调用已定义的函数（子 shell 内定义不泄漏）
command:
  f() { echo F; }; f | cat; echo "[$(f)]"; ( g() { echo g; }; g )

--- name: T3c/128-function-defined-in-pipeline-stage
# 段内重定义只影响该段，外层仍是原定义
command:
  f() { echo one; }; f | ( f() { echo two; }; f ) | cat; f

--- name: T3c/129-compound-fd-redirect-null
# 复合命令后接带 fd 前缀的重定向：docker 等工具与「跑批时静音 stderr」的常见写法
command:
  { echo out; echo err >&2; } 2>/dev/null; echo "rc=$?"

--- name: T3c/130-compound-fd-redirect-to-file
command:
  for i in 1 2; do echo "n=$i"; done 2>/tmp/vbash-t3c130.err; wc -c < /tmp/vbash-t3c130.err; rm -f /tmp/vbash-t3c130.err

--- name: T3c/131-compound-fd-redirect-order
# 2>&1 与 >file 的顺序仍然敏感，复合命令上同样成立
command:
  { echo a; echo b >&2; } 2>&1 > /tmp/vbash-t3c131.out | tr a-z A-Z; echo "---"; cat /tmp/vbash-t3c131.out; rm -f /tmp/vbash-t3c131.out

--- name: T3c/132-subshell-fd-redirect
command:
  ( echo sub; echo suberr >&2 ) 2>/dev/null

--- name: T3c/133-if-fd-redirect-stdin
command:
  if cat 0</dev/null; then echo no-input; fi

--- name: T3c/134-for-without-in-uses-positional
command:
  set -- a b
  for x; do echo $x; done

--- name: T3c/135-for-without-in-empty-positional
command:
  set --
  for x; do echo $x; done
  echo end

--- name: T3c/136-for-without-in-in-function
command:
  f() { for a; do echo "a=$a"; done; }
  f p q

--- name: T3c/137-break-outside-loop-warns-and-continues
command:
  echo a; break; echo b

--- name: T3c/138-continue-outside-loop-warns-and-continues
command:
  echo a; continue; echo b

--- name: T3c/139-break-in-function-inside-loop
# 函数内的 break 不算循环内：告警、返回 0、循环继续
command:
  f() { break; echo body; }
  for i in 1 2; do f; echo "loop$i"; done

--- name: T3c/140-exit-negative-wraps
command:
  exit -1

--- name: T3c/141-exit-non-numeric-continues
command:
  exit abc; echo after

--- name: T3c/142-return-negative
command:
  f() { return -1; }
  f; echo "rc=$?"

--- name: T3c/143-echo-c-suppresses-newline
command:
  echo -e "x\cy"; echo tail

--- name: T3c/144-echo-octal-escape
command:
  echo -e "a\0101b"

--- name: T3c/145-set-pipefail-pipeline
command:
  set -o pipefail
  false | true
  echo $?

--- name: T3c/146-set-nounset-unbound
command:
  set -u
  echo "$nope"
  echo unreached

--- name: T3c/147-set-nounset-default-still-works
command:
  set -u
  echo "[${nope:-fallback}]"

--- name: T3c/148-test-negative-integers
command:
  [ -2 -lt 0 ] && echo neg-lt
  test -1 -eq -1 && echo neg-eq

--- name: T3c/149-test-leading-zero-is-decimal
command:
  [ 010 -eq 10 ] && echo decimal

--- name: T3c/150-substring-expansion
command:
  v=abcdef
  echo "${v:1}" "${v:1:3}" "${v: -2}" "${v:2:-1}"

--- name: T3c/151-case-conversion-expansion
command:
  v=aBc
  echo "${v^^} ${v,,} ${v^} ${v,}"

--- name: T3c/152-indirect-expansion
command:
  x=hi
  v=x
  echo "${!v}"

--- name: T3c/153-arith-base-and-incr
command:
  echo $((2#101)) $((16#ff))
  n=5
  echo $((n++)) $n

--- name: T3c/154-arith-power
command:
  echo $((2**10)) $((1+2**3))

--- name: T3c/155-arith-nested-expansion
command:
  v=4
  echo $(( ${v} + 1 )) $(( 1 + $(( 2 )) )) $(( $(echo 3) + 1 ))

--- name: T3c/156-star-join-uses-ifs-first-char
command:
  IFS=,
  set -- a b c
  echo "[$*] [$@]"

--- name: T3c/157-dollar-dollar-is-real-pid
# $$ 为宿主 pid：非 0，且 kill -0 自己成功（不发信号，只做存在性探测）
command:
  echo $(( $$ > 0 )) ; kill -0 $$ && echo alive

--- name: T3c/158-kill-signal-name-lookup
# 内建 kill 的 -l 走内部信号表，不触碰任何进程
command:
  kill -l 9; kill -l KILL

--- name: T3c/159-printf-percent-q
command:
  printf '%q %q\n' 'a b' 'ab'
